# ─── Zekvolt: variables de entorno ───────────────────────────────────────
# Copia este archivo a .env y llena tus valores.
# NUNCA subas .env a git (ya esta en .gitignore).

# ─── Supabase ────────────────────────────────────────────────────────────
# Obtener en: Supabase Dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ─── NVIDIA NIM (Vision IA) ──────────────────────────────────────────────
# Obtener tu API key en: https://build.nvidia.com/
# Modelo: meta/llama-3.2-11b-vision-instruct
EXPO_PUBLIC_NVIDIA_API_KEY=tu-nvidia-api-key-aqui
EXPO_PUBLIC_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
EXPO_PUBLIC_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
EXPO_PUBLIC_NVIDIA_TIMEOUT_MS=30000

# ─── App ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=Zekvolt
EXPO_PUBLIC_APP_VERSION=1.0.0
